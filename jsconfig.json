{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*.js"],
  "exclude": ["dist", "node_modules", "reports", "reference/companions"]
}
